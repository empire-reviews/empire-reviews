<div class="empire-qa"
     id="empire-qa-{{ block.id }}"
     data-product-id="{{ product.id }}"
     data-shop-domain="{{ shop.permanent_domain }}"
     style="--empire-qa-accent: {{ block.settings.accent_color }}; --empire-qa-text: {{ block.settings.text_color }}; --empire-qa-bg: {{ block.settings.bg_color }};">

  <div class="empire-qa-head">
    <h3 class="empire-qa-title">{{ block.settings.heading | escape }}</h3>
    <button type="button" class="empire-qa-ask-btn" data-empire-qa-toggle>{{ block.settings.ask_label | escape }}</button>
  </div>

  <form class="empire-qa-form" data-empire-qa-form style="display:none;">
    <input type="text" class="empire-qa-input" data-empire-qa-name placeholder="{{ block.settings.name_placeholder | escape }}" maxlength="100" />
    <textarea class="empire-qa-textarea" data-empire-qa-body placeholder="{{ block.settings.q_placeholder | escape }}" maxlength="1000" rows="3"></textarea>
    <button type="submit" class="empire-qa-submit">{{ block.settings.submit_label | escape }}</button>
    <div class="empire-qa-formmsg" data-empire-qa-msg></div>
  </form>

  <div class="empire-qa-list" data-empire-qa-list>
    <div class="empire-qa-loading">…</div>
  </div>
</div>

<style>
  #empire-qa-{{ block.id }}.empire-qa { font-family: inherit; color: var(--empire-qa-text, #1a1a1a); background: var(--empire-qa-bg, transparent); margin: 32px 0; }
  #empire-qa-{{ block.id }} .empire-qa-head { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:16px; flex-wrap:wrap; }
  #empire-qa-{{ block.id }} .empire-qa-title { font-size:1.25rem; font-weight:700; margin:0; }
  #empire-qa-{{ block.id }} .empire-qa-ask-btn, #empire-qa-{{ block.id }} .empire-qa-submit { background: var(--empire-qa-accent, #111); color:#fff; border:none; border-radius:8px; padding:10px 18px; font-weight:600; cursor:pointer; font-size:0.9rem; }
  #empire-qa-{{ block.id }} .empire-qa-form { display:flex; flex-direction:column; gap:10px; margin-bottom:20px; padding:16px; border:1px solid rgba(0,0,0,0.08); border-radius:10px; }
  #empire-qa-{{ block.id }} .empire-qa-input, #empire-qa-{{ block.id }} .empire-qa-textarea { width:100%; padding:10px 12px; border:1px solid rgba(0,0,0,0.15); border-radius:8px; font-size:0.95rem; font-family:inherit; box-sizing:border-box; }
  #empire-qa-{{ block.id }} .empire-qa-submit { align-self:flex-start; }
  #empire-qa-{{ block.id }} .empire-qa-formmsg { font-size:0.85rem; }
  #empire-qa-{{ block.id }} .empire-qa-item { padding:16px 0; border-bottom:1px solid rgba(0,0,0,0.08); }
  #empire-qa-{{ block.id }} .empire-qa-q { display:flex; gap:8px; font-weight:600; }
  #empire-qa-{{ block.id }} .empire-qa-q-mark { color: var(--empire-qa-accent, #111); font-weight:800; }
  #empire-qa-{{ block.id }} .empire-qa-meta { font-size:0.78rem; opacity:0.6; margin-top:2px; margin-left:18px; }
  #empire-qa-{{ block.id }} .empire-qa-a { display:flex; gap:8px; margin:10px 0 0 18px; padding:10px 12px; background:rgba(0,0,0,0.03); border-radius:8px; }
  #empire-qa-{{ block.id }} .empire-qa-a-mark { color: var(--empire-qa-accent, #111); font-weight:800; }
  #empire-qa-{{ block.id }} .empire-qa-a-merchant { font-size:0.7rem; text-transform:uppercase; letter-spacing:0.5px; font-weight:700; color: var(--empire-qa-accent, #111); margin-left:6px; }
  #empire-qa-{{ block.id }} .empire-qa-empty, #empire-qa-{{ block.id }} .empire-qa-loading { opacity:0.6; padding:12px 0; }
</style>

<script>
(function() {
  var root = document.getElementById("empire-qa-{{ block.id }}");
  if (!root) return;
  var HOST = 'https://empire-reviews.vercel.app';
  var listEl = root.querySelector('[data-empire-qa-list]');
  var form = root.querySelector('[data-empire-qa-form]');
  var toggle = root.querySelector('[data-empire-qa-toggle]');
  var msgEl = root.querySelector('[data-empire-qa-msg]');

  var shopDomain = root.dataset.shopDomain || (window.Shopify && window.Shopify.shop) || '';
  var rawPid = (root.dataset.productId || '').trim();
  var productId = (rawPid && rawPid.indexOf('{' + '{') === -1) ? rawPid.replace('gid://shopify/Product/', '') : '';

  function esc(s) {
    return String(s == null ? '' : s)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  function render(questions) {
    if (!questions || !questions.length) {
      listEl.innerHTML = '<div class="empire-qa-empty">{{ block.settings.empty_text | escape }}</div>';
      return;
    }
    var html = '';
    questions.forEach(function(q) {
      var date = '';
      try { date = new Date(q.createdAt).toLocaleDateString(); } catch (e) {}
      html += '<div class="empire-qa-item">';
      html += '<div class="empire-qa-q"><span class="empire-qa-q-mark">Q</span><span>' + esc(q.body) + '</span></div>';
      html += '<div class="empire-qa-meta">' + esc(q.customerName || 'Anonymous') + (date ? ' · ' + esc(date) : '') + '</div>';
      (q.answers || []).forEach(function(a) {
        html += '<div class="empire-qa-a"><span class="empire-qa-a-mark">A</span><div><span>' + esc(a.body) + '</span>';
        html += '<span class="empire-qa-meta" style="margin-left:0;display:block;">' + esc(a.author || 'Store') +
                (a.isMerchant ? '<span class="empire-qa-a-merchant">{{ block.settings.merchant_label | escape }}</span>' : '') + '</span>';
        html += '</div></div>';
      });
      html += '</div>';
    });
    listEl.innerHTML = html;
  }

  function load() {
    var url = HOST + '/api/questions?shop=' + encodeURIComponent(shopDomain);
    if (productId) url += '&productId=' + encodeURIComponent(productId);
    fetch(url)
      .then(function(r) { return r.json(); })
      .then(function(d) { render(d.questions || []); })
      .catch(function() { listEl.innerHTML = '<div class="empire-qa-empty">{{ block.settings.empty_text | escape }}</div>'; });
  }

  if (toggle) toggle.addEventListener('click', function() {
    form.style.display = form.style.display === 'none' ? 'flex' : 'none';
  });

  if (form) form.addEventListener('submit', function(e) {
    e.preventDefault();
    var name = root.querySelector('[data-empire-qa-name]').value || '';
    var body = root.querySelector('[data-empire-qa-body]').value || '';
    if (!body.trim()) { msgEl.textContent = ''; return; }
    var fd = new FormData();
    fd.append('author', name);
    fd.append('body', body);
    if (productId) fd.append('productId', productId);
    var submitBtn = form.querySelector('.empire-qa-submit');
    submitBtn.disabled = true;
    fetch(HOST + '/api/questions?shop=' + encodeURIComponent(shopDomain), { method: 'POST', body: fd })
      .then(function(r) { return r.json(); })
      .then(function(d) {
        submitBtn.disabled = false;
        if (d.success) {
          msgEl.style.color = '#16a34a';
          msgEl.textContent = '{{ block.settings.thanks_text | escape }}';
          root.querySelector('[data-empire-qa-body]').value = '';
          if (d.status === 'approved') load();
        } else {
          msgEl.style.color = '#ef4444';
          msgEl.textContent = d.error || 'Could not submit your question.';
        }
      })
      .catch(function() { submitBtn.disabled = false; msgEl.style.color = '#ef4444'; msgEl.textContent = 'Network error.'; });
  });

  load();
})();
</script>

{% schema %}
{
  "name": "Product Q&A",
  "target": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions & Answers" },
    { "type": "text", "id": "ask_label", "label": "Ask button label", "default": "Ask a Question" },
    { "type": "text", "id": "submit_label", "label": "Submit button label", "default": "Post Question" },
    { "type": "text", "id": "name_placeholder", "label": "Name field placeholder", "default": "Your name (optional)" },
    { "type": "text", "id": "q_placeholder", "label": "Question field placeholder", "default": "Type your question..." },
    { "type": "text", "id": "empty_text", "label": "Empty state text", "default": "No questions yet — be the first to ask!" },
    { "type": "text", "id": "thanks_text", "label": "Submitted confirmation", "default": "Thanks! Your question was submitted for review." },
    { "type": "text", "id": "merchant_label", "label": "Official answer badge", "default": "Official" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#111111" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#1a1a1a" },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#ffffff" }
  ]
}
{% endschema %}
