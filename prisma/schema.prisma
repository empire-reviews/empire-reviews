// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  // Analytics & Conversion Tracking
  appInstalledAt     DateTime  @default(now())
  lastUpgradePrompt  DateTime?
  upgradePromptCount Int       @default(0)
}

// Empire Reviews Models

model Review {
  id            String        @id @default(uuid())
  shop          String
  productId     String?
  customerId    String?
  customerName  String?
  customerEmail String?
  rating        Int
  title         String?
  body          String?
  status        String        @default("pending")
  verified      Boolean       @default(false)
  source        String        @default("native") // native | csv | google | aliexpress
  sentiment     String?
  media         ReviewMedia[]
  replies       Reply[]
  createdAt     DateTime      @default(now())

  @@index([shop])
  @@index([productId])
  @@index([status])
  @@index([shop, productId, status])  // hot path: product widget query
  @@index([shop, status])             // hot path: store-wide widget / trust badge
}

// Customer Questions & Answers (product Q&A section)
model Question {
  id            String   @id @default(uuid())
  shop          String
  productId     String?
  customerName  String?
  customerEmail String?
  body          String
  status        String   @default("pending") // pending | approved | rejected
  answers       Answer[]
  createdAt     DateTime @default(now())

  @@index([shop])
  @@index([productId])
  @@index([shop, productId, status]) // hot path: product Q&A widget query
  @@index([shop, status])
}

model Answer {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  body       String
  author     String? // display name for the answer
  isMerchant Boolean  @default(false) // merchant "official" answer vs. another shopper
  status     String   @default("approved") // approved | pending | rejected
  createdAt  DateTime @default(now())

  @@index([questionId])
}

// Loyalty: discount-code reward issued for an approved review
model Reward {
  id            String   @id @default(uuid())
  shop          String
  reviewId      String? // the review that earned the reward
  customerEmail String
  discountCode  String
  amount        String // human-readable, e.g. "10%" or "$5"
  status        String   @default("issued") // issued | used | expired
  createdAt     DateTime @default(now())

  @@index([shop])
  @@index([customerEmail])
  @@index([shop, customerEmail])
}

model ReviewMedia {
  id        String   @id @default(uuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  url       String
  type      String
  createdAt DateTime @default(now())
}

model Reply {
  id        String   @id @default(uuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
}

model Settings {
  id                     String  @id @default(uuid())
  shop                   String  @unique
  autoPublish            Boolean @default(false)
  publishMode            String  @default("five_star") // none | five_star | all
  emailAlerts            Boolean @default(true)
  themeColor             String  @default("#000000")
  accentColor            String  @default("#3b82f6")
  bgColor                String  @default("#ffffff")
  widgetBgColor          String  @default("#ffffff")
  starColor              String  @default("#fbbf24")
  borderRadius           String  @default("8px")
  enableFloatingTab      Boolean @default(false)
  floatingTabPosition    String  @default("left") // "left" or "right"
  enableAiSummary        Boolean @default(false)
  enableFlow             Boolean @default(false)
  enableKlaviyo          Boolean @default(false)
  klaviyoApiKey          String?
  enableGoogle           Boolean @default(false)
  plan                   String  @default("FREE") // FREE, EMPIRE_PRO
  hasCompletedOnboarding Boolean @default(false)
  adminEmail             String?
  language               String  @default("en")
  businessType           String?
  isDropshipping         Boolean @default(false)
  acquisitionStrategy    String? // JSON string
  storeLogoUrl           String?

  // AI Configuration (BYOK)
  aiProvider          String? // "openai" | "gemini" | "claude" | "deepseek" | "ollama"
  aiApiKey            String? // Merchant's own API key
  aiInsightsSummary   String? // Cached AI insight text
  aiInsightsUpdatedAt DateTime? // Cache timestamp

  // Email Automation
  resendApiKey       String?
  reviewRequestDelay Int     @default(3) // Days after order to send email
  senderEmail        String  @default("reviews@empirereviews.com")
  physicalAddress    String? // CAN-SPAM required mailing address

  // Loyalty / Rewards — issue a discount code when a review is approved
  enableRewards      Boolean @default(false)
  rewardType         String  @default("percentage") // percentage | fixed
  rewardValue        Int     @default(10) // 10 (%) or amount in store currency
  rewardMinRating    Int     @default(1) // minimum star rating to earn a reward
  rewardRequirePhoto Boolean @default(false) // only reward reviews that include a photo
}

model Campaign {
  id           String   @id @default(uuid())
  shop         String
  name         String
  subject      String
  body         String
  templateType String // reciprocity, altruism, scarcity
  discount     Int?
  status       String   @default("draft") // draft, active, paused, completed
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sends   CampaignSend[]
  metrics CampaignMetrics?
}

model CampaignSend {
  id            String    @id @default(uuid())
  campaignId    String
  campaign      Campaign  @relation(fields: [campaignId], references: [id])
  customerEmail String
  customerName  String?
  orderId       String?
  sentAt        DateTime  @default(now())
  openedAt      DateTime?
  clickedAt     DateTime?
  reviewId      String?

  @@unique([orderId, customerEmail])  // Prevent duplicate sends at the DB level
  @@index([campaignId])
  @@index([customerEmail])
  @@index([sentAt])    // For time-series analytics
  @@index([openedAt])
  @@index([clickedAt])
}

model CampaignMetrics {
  id             String   @id @default(uuid())
  campaignId     String   @unique
  campaign       Campaign @relation(fields: [campaignId], references: [id])
  totalSent      Int      @default(0)
  totalOpened    Int      @default(0)
  totalClicked   Int      @default(0)
  totalReviews   Int      @default(0)
  openRate       Float    @default(0)
  clickRate      Float    @default(0)
  conversionRate Float    @default(0)
  updatedAt      DateTime @updatedAt
}

// Analytics & Conversion Tracking
model AnalyticsEvent {
  id        String   @id @default(uuid())
  shop      String
  event     String // e.g., "page_view", "upgrade_click", "feature_used"
  page      String? // e.g., "dashboard", "reviews", "plans"
  metadata  String? // JSON string for additional data
  timestamp DateTime @default(now())

  @@index([shop])
  @@index([event])
  @@index([timestamp])
}

// Real Data: Order Integration for Business Impact
model Order {
  id            String   @id // Shopify Order Admin GraphQL ID (gid://shopify/Order/123)
  shop          String
  totalPrice    Decimal  @db.Decimal(10, 2) // NOT NULL in DB; all writers default to 0 on partial payloads
  currency      String
  createdAt     DateTime
  fulfilledAt   DateTime? // When order was shipped
  deliveredAt   DateTime? // When order was delivered
  customerEmail String?
  productTitle  String? // Store primary purchased product name
  productId     String? // Store primary product ID to fetch handles

  // Automation Tracking
  reviewRequestSentAt DateTime?
  reviewRequestStatus String    @default("pending") // pending, sent, failed, skipped (if no email)

  @@index([shop])
  @@index([createdAt])
  @@index([reviewRequestStatus])
  @@index([shop, reviewRequestStatus]) // Composite index for cron job queries
  @@index([customerEmail])             // For unsubscribe checks
  @@index([fulfilledAt])
  @@index([deliveredAt])
}

// Email Compliance
model Unsubscriber {
  id        String   @id @default(uuid())
  email     String
  shop      String
  createdAt DateTime @default(now())

  @@unique([email, shop])
  @@index([email])
  @@index([shop])
}

// In-app support assistant conversation log. One row per Q&A exchange so we can
// see what merchants ask, how often, and spot when many hit the same issue.
model SupportLog {
  id        String   @id @default(uuid())
  shop      String
  question  String
  answer    String
  usedAi    Boolean  @default(false) // true if an AI provider answered (vs. canned/human)
  learned   Boolean  @default(false) // true if a curated LearnedAnswer answered it
  escalated Boolean  @default(false) // true if the bot routed the user to a human
  helpful   Boolean? // 👍 = true, 👎 = false, null = no feedback yet
  taught    Boolean  @default(false) // true once a merchant turned this gap into a LearnedAnswer
  createdAt DateTime @default(now())

  @@index([shop])
  @@index([createdAt])
  @@index([shop, createdAt])
}

// Human-approved answers that the bot reuses. GLOBAL (not shop-scoped) because
// app how-to knowledge is the same for every merchant — teaching the bot once
// improves it for everyone. This is the "learns from mistakes" memory: a gap the
// bot failed gets turned into a verified LearnedAnswer here.
model LearnedAnswer {
  id        String   @id @default(uuid())
  question  String   // the example/trigger question this answers
  answer    String   // the verified answer the bot should give
  keywords  String   @default("") // comma-separated keywords for matching
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

// Two-way support inbox: merchant ↔ Empire team. The merchant posts from the
// support widget's Messages tab; the owner replies from the Support & Learning
// panel. Shop-scoped — each merchant only ever sees their own thread.
model SupportMessage {
  id        String    @id @default(uuid())
  shop      String
  sender    String // "merchant" | "team"
  body      String
  readAt    DateTime? // null until the other side has seen it
  createdAt DateTime  @default(now())

  @@index([shop])
  @@index([shop, createdAt])
}

// Live presence for the support inbox. A single "owner" row, updated by the
// Support & Learning panel's heartbeat. `lastSeenAt` drives the Online/Offline
// badge in the merchant widget; `typingShop`/`typingAt` drive the typing dots
// shown to the specific merchant the owner is currently replying to.
model SupportPresence {
  scope      String    @id // "owner" (single row)
  lastSeenAt DateTime  @default(now())
  typingShop String? // which merchant shop the owner is currently typing to
  typingAt   DateTime?
  updatedAt  DateTime  @updatedAt
}

// Rate Limiting (Database-Backed)
model RateLimit {
  id        String   @id @default(uuid())
  key       String   // IP address or identifier
  window    String   // Time window identifier (e.g. "2026-03-24T22:00")
  count     Int      @default(1)
  expiresAt DateTime // Auto-cleanup: when this record can be deleted
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, window])
  @@index([expiresAt])
}
