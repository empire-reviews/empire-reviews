<div class="empire-ai-minimal" 
     id="empire-ai-summary-{{ block.id }}"
     data-product-id="{{ product.id }}"
     data-shop-domain="{{ shop.permanent_domain }}"
     style="--empire-bg: {{ block.settings.bg_color }}; --empire-text: {{ block.settings.text_color }}; --empire-title: {{ block.settings.title_color }}; --empire-border: {{ block.settings.border_color }}; --empire-text-size: {{ block.settings.text_size }}px;">
    
    <div class="empire-ai-header">
        <div class="empire-ai-badge-wrap" style="background: var(--empire-title);">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="empire-ai-sparkle"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"></path></svg>
            <span class="empire-ai-badge-text">Empire AI Analysis</span>
        </div>
        <h3 class="empire-ai-title">Customer Consensus</h3>
    </div>
    
    <div class="empire-ai-content empire-loading-pulse">
        <div class="empire-ai-shimmer-line"></div>
        <div class="empire-ai-shimmer-line" style="width: 85%;"></div>
        <div class="empire-ai-shimmer-line" style="width: 60%;"></div>
    </div>

    <div class="empire-ai-disclaimer" style="display: none;">
        <span>Generated from the text of customer reviews</span>
    </div>
</div>

<style>
.empire-ai-minimal {
    font-family: inherit;
    background: var(--empire-bg, #fafafa);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 8px;
    padding: 24px 28px;
    margin: 32px 0;
    position: relative;
    overflow: hidden;
    color: var(--empire-text, #1a1a1a);
}

.empire-ai-minimal::before {
    content: '';
    position: absolute;
    top: 0; left: 0; width: 4px; height: 100%;
    background: var(--empire-border, #000000);
}

.empire-ai-header {
    margin-bottom: 16px;
}

.empire-ai-badge-wrap {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #ffffff;
    padding: 4px 10px;
    border-radius: 4px;
    margin-bottom: 12px;
}

.empire-ai-sparkle {
    animation: empire-spin 4s linear infinite;
}

.empire-ai-badge-text {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
}

.empire-ai-title {
    font-size: calc(var(--empire-text-size) * 1.3);
    font-weight: 600;
    margin: 0;
    letter-spacing: -0.01em;
    color: var(--empire-title, #000000);
}

.empire-ai-content {
    font-size: var(--empire-text-size, 15px);
    line-height: 1.6;
    color: var(--empire-text, #4a4a4a);
    margin-bottom: 12px;
}

.empire-ai-disclaimer {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: calc(var(--empire-text-size) * 0.85);
    color: #6b7280;
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid rgba(0,0,0,0.06);
}

.empire-loading-pulse { opacity: 1; }

.empire-ai-shimmer-line {
    height: 12px;
    border-radius: 6px;
    margin-bottom: 12px;
    background: linear-gradient(90deg, #eeeeee 25%, #f5f5f5 50%, #eeeeee 75%);
    background-size: 200% 100%;
    animation: empire-shimmer 1.5s infinite linear;
}

@keyframes empire-spin { 100% { transform: rotate(360deg); } }
@keyframes empire-shimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const el = document.getElementById("empire-ai-summary-{{ block.id }}");
    if (!el) return;
    
    const productId = el.dataset.productId;
    const shopDomain = el.dataset.shopDomain;
    const cacheDuration = "{{ block.settings.cache_duration }}";
    
    const host = 'https://empire-reviews.vercel.app';
    let url = `${host}/api/reviews?shop=${shopDomain}&intent=summary&cache=${cacheDuration}`;
    if (productId && productId.trim() !== '') {
        const pureId = productId.replace('gid://shopify/Product/', '');
        url += `&productId=${pureId}`;
    }

    fetch(url)
        .then(res => res.json())
        .then(data => {
            const contentEl = el.querySelector('.empire-ai-content');
            contentEl.classList.remove('empire-loading-pulse');
            
            if (data.summary && data.summary.trim() !== "") {
                contentEl.innerText = data.summary;
                el.querySelector('.empire-ai-disclaimer').style.display = 'flex';
            } else {
                contentEl.innerText = "Not enough reviews to generate a reliable summary yet.";
                contentEl.style.opacity = '0.7';
            }
        })
        .catch(err => {
            const content = el.querySelector('.empire-ai-content');
            content.classList.remove('empire-loading-pulse');
            content.innerText = "Network Error: Could not connect to Empire Reviews API. " + err.message;
            content.style.color = '#ef4444';
        });
});
</script>

{% schema %}
{
  "name": "AI Review Summary",
  "target": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fafafa"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title & Badge Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Highlight Border Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text Size",
      "default": 15
    },
    {
      "type": "select",
      "id": "cache_duration",
      "label": "API Caching Duration",
      "info": "Prevents the API from being overloaded. 1 hour recommended.",
      "options": [
        { "value": "10m", "label": "10 Minutes" },
        { "value": "1h", "label": "1 Hour" },
        { "value": "1d", "label": "1 Day" },
        { "value": "1w", "label": "1 Week" }
      ],
      "default": "1h"
    }
  ]
}
{% endschema %}
